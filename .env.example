# ─── Frontend Environment Variables (Vercel / Local) ───────────────────────────
# For Vercel deployment: Set VITE_API_BASE_URL in Vercel Project Settings -> Environment Variables
# If omitted, Vercel automatically proxies /api to https://smart-manure-backend.onrender.com/api via vercel.json.

VITE_API_BASE_URL=https://smart-manure-backend.onrender.com/api

# ─── Backend Environment Variables (Render / Railway / Local) ─────────────────
# Set these in your Render Dashboard -> Environment:

# SECRET_KEY=your_random_32_byte_hex_string
# DATABASE_URL=sqlite:////data/app.db
# ALLOW_ALL_ORIGINS=true

# ─── Gmail SMTP (For Live OTP Delivery to Personal Gmail) ──────────────────────
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=16_character_google_app_password
# SMTP_FROM=your_email@gmail.com
