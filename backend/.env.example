# ─── GOBARdhan Smart Manure Backend Configuration ──────────────────────────────
# Copy this file to backend/.env or set these in Render / Railway Environment Variables.

# Secret key for JWT session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_your_secure_secret_key_here

# SQLite or PostgreSQL database URL
# Local: sqlite:///./database/app.db
# Render persistent disk: sqlite:////data/app.db
DATABASE_URL=sqlite:///./database/app.db

# Environment mode: development | production
ENVIRONMENT=production

# Permissive or explicit CORS origins
ALLOWED_ORIGINS=https://crop-monitoring-and-prediction.vercel.app,http://localhost:5173,http://127.0.0.1:5173
ALLOW_ALL_ORIGINS=true

# ─── Gmail SMTP Configuration for Real Verification OTP Delivery ──────────────
# To enable real OTP delivery to users' Gmail inboxes:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create a new App Password named "Smart Manure"
# 4. Paste the 16-character generated code below (spaces are automatically handled)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM=your_email@gmail.com

