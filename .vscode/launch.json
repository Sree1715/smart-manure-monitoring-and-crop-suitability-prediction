{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Backend (Port 8000)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--app-dir",
                "backend",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome (Frontend)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}"
        }
    ]
}