# ─── Frontend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in values for local development.
# For Vercel deployment, set VITE_API_BASE_URL in the Vercel project settings.

# Backend API URL (local development)
VITE_API_BASE_URL=http://localhost:8000/api

# ─── For Production (Render/Railway/etc.) ────────────────────────────────────
# Set this in Vercel Environment Variables:
# VITE_API_BASE_URL=https://smart-manure-backend.onrender.com/api
